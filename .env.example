# Copy to .env.local (gitignored) to override. The server, tests, and drizzle-kit all
# default to this exact connection string (it matches docker-compose.yml), so for the
# standard dev setup (`docker compose up -d postgres`) you need set NOTHING here.
DATABASE_URL=postgres://aiworkflow:aiworkflow@localhost:5432/aiworkflow

# Dev record/replay for the claude-cli provider (see docs/dev-record-replay.md):
#   unset  -> pure production path
#   1       -> auto (replay if a cassette exists, else record)
#   record  -> force-refresh cassettes
# DEV_RECORD_REPLAY=1
