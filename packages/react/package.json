    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "sass": "^1.80.0",
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
