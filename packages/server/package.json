{
  "name": "@atizar/server",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build"
  },
  "exports": {
    ".": {
      "atizar-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db/schema": {
      "atizar-src": "./src/db/schema.ts",
      "types": "./dist/db/schema.d.ts",
      "import": "./dist/db/schema.js"
    },
    "./mastra": {
      "atizar-src": "./src/mastraTools.ts",
      "types": "./dist/mastra.d.ts",
      "import": "./dist/mastra.js"
    }
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.55",
    "@atizar/core": "^0.1.1",
    "@hono/node-server": "^2.0.4",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.23",
    "postgres": "^3.4.9",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "@mastra/core": "^1.41.0"
  },
  "peerDependenciesMeta": {
    "@mastra/core": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.0"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "vite-plugin-dts": "^4.5.4"
  }
}
