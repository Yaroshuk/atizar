{
  "name": "inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "../../scripts/ensure-postgres.sh; lsof -tiTCP:4000 -tiTCP:5173 -sTCP:LISTEN 2>/dev/null | xargs -I{} kill -9 {} 2>/dev/null; sleep 1; true",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/pipeline/db/migrate.ts",
    "db:reset": "tsx -e \"import('./server/pipeline/db/reset.js').then(m=>m.resetDb()).then(()=>process.exit(0))\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c ../../vitest.config.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.55",
    "@ai-sdk/anthropic": "^3.0.82",
    "@hono/node-server": "^2.0.4",
    "@mastra/core": "^1.41.0",
    "@mastra/pg": "^1.12.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@platform/core": "*",
    "@platform/integrations": "*",
    "@platform/providers": "*",
    "googleapis": "^173.0.0",
    "hono": "^4.12.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@rolldown/binding-darwin-arm64": "^1.0.3"
  }
}
