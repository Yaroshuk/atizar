{
  "name": "inbox",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "[ \"$DEMO\" = \"1\" ] || ../../scripts/ensure-postgres.sh; lsof -tiTCP:4000 -tiTCP:5173 -sTCP:LISTEN 2>/dev/null | xargs -I{} kill -9 {} 2>/dev/null; sleep 1; true",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "demo": "DEMO=1 concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "demo:scan-cassettes": "tsx server/scan-demo-cassettes.ts",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -e \"import('@atizar/server').then(m=>m.runMigrations()).then(()=>process.exit(0))\"",
    "db:reset": "tsx -e \"import('@atizar/server').then(m=>m.resetDb()).then(()=>process.exit(0))\"",
    "db:reset:creds": "tsx -e \"import('@atizar/server').then(m=>m.resetCredentials()).then(()=>process.exit(0))\"",
    "db:reset:all": "tsx -e \"import('@atizar/server').then(m=>m.resetAll()).then(()=>process.exit(0))\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run -c ../../vitest.config.ts",
    "ui": "playwright test --headed",
    "ui:smoke": "playwright test",
    "ui:report": "playwright show-report",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.55",
    "@ai-sdk/anthropic": "^3.0.82",
    "@atizar/core": "*",
    "@atizar/integrations": "*",
    "@atizar/providers": "*",
    "@atizar/react": "*",
    "@atizar/server": "*",
    "@hono/node-server": "^2.0.4",
    "@mastra/core": "^1.41.0",
    "@mastra/pg": "^1.12.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "googleapis": "^173.0.0",
    "hono": "^4.12.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
